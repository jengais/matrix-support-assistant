# Loaded with python-dotenv's load_dotenv() in src/support_assistant/config.py

# OpenAI (read directly by the OpenAI SDK)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# LangSmith tracing (read directly by the LangSmith SDK). Set to true once the key is filled in.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=support-assistant

# Business date fixed by the assignment. Remove to use the real date.
REFERENCE_DATE=2026-09-22
DATA_DIR=data
SERVICE_REQUESTS_FILE=var/service_requests.jsonl
